@model AssignmentCore.ViewModels.UserCreateViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card p-3 w-50">
    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label class="form-label">User Name</label>
            <input asp-for="UserName" class="form-control mb-1" />
            <span asp-validation-for="UserName" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control mb-1" />
            <span asp-validation-for="FullName" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control mb-1" />
            <span asp-validation-for="Email" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input asp-for="Password" class="form-control mb-1" />
            <span asp-validation-for="Password" class="text-danger text-sm block mt-1"></span>
        </div>

        @* Role'i formda gizli tutuyoruz, Teacher/Student controller'da set edildi *@
        <input type="hidden" asp-for="Role" />

        <div class="mb-3 flex items-center gap-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Is Active</label>
            <span></span>
        </div>

        <div class="flex justify-between">
            <button type="submit" class="btn btn-primary">Save</button>

            @if (Model.Role == "Teacher")
            {
                <a asp-action="Teachers" class="btn btn-secondary">Back</a>
            }
            else
            {
                <a asp-action="Students" class="btn btn-secondary">Back</a>
            }
        </div>
    </form>
</div>
