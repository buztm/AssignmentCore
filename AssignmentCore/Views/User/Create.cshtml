@model AssignmentCore.ViewModels.UserCreateViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h4 class="card-header text-info-500 mb-16 p-4">Create @Model.Role</h4>

    <!-- VALIDATION -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    <form asp-action="Create" method="post" class="row g-3">

        <!-- USERNAME -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">User Name</label>
            <input asp-for="UserName" class="form-control radius-12" placeholder="Enter username" />
            <span asp-validation-for="UserName" class="text-danger text-sm d-block"></span>
        </div>

        <!-- FULLNAME -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Full Name</label>
            <input asp-for="FullName" class="form-control radius-12" placeholder="Enter full name" />
            <span asp-validation-for="FullName" class="text-danger text-sm d-block"></span>
        </div>

        <!-- EMAIL -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Email</label>
            <input asp-for="Email" class="form-control radius-12" placeholder="Enter email" />
            <span asp-validation-for="Email" class="text-danger text-sm d-block"></span>
        </div>

        <!-- PASSWORD -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Password</label>
            <input asp-for="Password" type="password" class="form-control radius-12" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger text-sm d-block"></span>
        </div>

        <!-- CONFIRM PASSWORD -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control radius-12" placeholder="Re-enter password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger text-sm d-block"></span>
        </div>

        <!-- ROLE (HIDDEN) -->
        <input type="hidden" asp-for="Role" />

        <!-- IS ACTIVE -->
        <div class="col-md-6 d-flex align-items-start mt-3 mb-3">
            <input asp-for="IsActive" class="form-check-input me-4" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary px-16">Save</button>

            @if (Model.Role == "Teacher")
            {
                <a asp-action="Teachers" class="btn btn-secondary px-16">Back</a>
            }
            else
            {
                <a asp-action="Students" class="btn btn-secondary px-16">Back</a>
            }
        </div>

    </form>
</div>
