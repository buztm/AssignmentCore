@model AssignmentCore.Models.User
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Delete User";
    ViewData["subTitle"] = Model.Role == "Teacher" ? "Delete Teacher" : "Delete Student";
}

<div class="card p-3 w-50">
    <p class="bg-danger text-black-50 rounded-3 p-3 mb-3">
        Are you sure you want to delete this user?
    </p>

    <table class="basic-border-table mb-3">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Is Active?</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.UserName</td>
                <td>@Model.FullName</td>
                <td>@Model.Email</td>
                <td>@Model.Role</td>
                <td>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="flex justify-between">
            <button type="submit" class="btn btn-danger">Delete</button>

            @if (Model.Role == "Teacher")
            {
                <a asp-action="Teachers" class="btn btn-secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Students" class="btn btn-secondary">Cancel</a>
            }
        </div>
    </form>
</div>
