@model AssignmentCore.Models.User
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Delete User";
    ViewData["subTitle"] = Model.Role == "Teacher" ? "Delete Teacher" : "Delete Student";
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h4 class="card-header text-danger-500 mb-16 p-4">Delete @Model.Role</h4>

    <div class="alert alert-danger">
        Are you sure you want to delete this user?
    </div>

    <div class="table-responsive radius-16">
        <table class="table striped-table align-middle">
            <thead>
                <tr class="bg-danger">
                    <th class="text-light">Full Name</th>
                    <th class ="text-light">Email</th>
                    <th class="text-light">Status</th>
                </tr>
            </thead>
            <tbody class="border-top">
                <tr class="border-bottom">
                    <td>@Model.FullName</td>
                    <td>@Model.Email</td>
                    <td>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-danger">Delete</button>

            @if (Model.Role == "Teacher")
            {
                <a asp-action="Teachers" class="btn btn-secondary px-16">Cancel</a>
            }
            else
            {
                <a asp-action="Students" class="btn btn-secondary px-16">Cancel</a>
            }
        </div>
    </form>
</div>
