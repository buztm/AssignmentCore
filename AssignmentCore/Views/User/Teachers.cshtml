@model List<AssignmentCore.Models.User>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Teachers";
    ViewData["subTitle"] = "Teacher List";
}

<div class="card p-16 radius-16 shadow-sm rounded-4">

    <div class="d-flex justify-content-between align-items-center mb-16">
        <h2 class="h4 fw-semibold mb-0">Teacher List</h2>
        <a asp-action="CreateTeacher" class="btn btn-primary px-8">+ New Teacher</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">
            There is no teacher yet!
        </div>
    }
    else
    {
        <div class="table-responsive radius-16">
            <table class="table striped-table align-middle">

                <thead class="">
                    <tr class="bg-primary">
                        <th class="text-light">User Name</th>
                        <th class="text-light">Full Name</th>
                        <th class="text-light">Email</th>
                        <th class="text-light">Status</th>
                        <th class="text-light text-end">Actions</th>
                    </tr>
                </thead>

                <tbody class="border-top">
                    @foreach (var u in Model)
                    {
                        <tr class="border-bottom">

                            <td>@u.UserName</td>
                            <td>@u.FullName</td>
                            <td>@u.Email</td>

                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }
</div>
