@model List<AssignmentCore.Models.User>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Students";
    ViewData["subTitle"] = "Students List";
}

<div class="card p-3">
    <div class="flex justify-between mb-4">
        <h2 class="text-xxl font-semibold mb-3">Student List</h2>
        <a asp-action="CreateStudent" class="btn btn-primary">New Student</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="p-3 mb-3 bg-warning rounded text-black-50">
            There is no student yet!
        </div>
    }

    <table class="striped-table rounded-4 bg-primary">
        <thead>
            <tr>
                <th class="text-white">User Name</th>
                <th class="text-white">Full Name</th>
                <th class="text-white">Email</th>
                <th class="text-white">Is Active?</th>
                <th class="text-right text-white">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="hover:bg-slate-700/30 transition">
                    <td>@u.UserName</td>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td class="text-right">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-xs btn-primary me-2">Edit</a>
                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-xs btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
