@model AssignmentCore.ViewModels.UserProfileViewModel
@{
    ViewData["title"] = "Profile";
    ViewData["subTitle"] = "View Profile";

    ViewData["script"] = @"
    <script>
    // ======================== Upload Image Start =====================
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#imagePreview').css('background-image', 'url(' + e.target.result + ')');
                $('#imagePreview').hide();
                $('#imagePreview').fadeIn(650);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    $('#imageUpload').change(function () {
        readURL(this);
    });
    // ======================== Upload Image End =====================

    // ================== Password Show Hide Js Start ==========
    function initializePasswordToggle(toggleSelector) {
        $(toggleSelector).on('click', function () {
            $(this).toggleClass('ri-eye-off-line');
            var input = $($(this).attr('data-toggle'));
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
            } else {
                input.attr('type', 'password');
            }
        });
    }
    initializePasswordToggle('.toggle-password');
    // ========================= Password Show Hide Js End ===========================
    </script>
    ";

    var activeTab = (ViewBag.ActiveTab as string) ?? "edit";
    var editActive = activeTab == "edit" ? "active" : "";
    var editShow = activeTab == "edit" ? "show active" : "";

    var passActive = activeTab == "password" ? "active" : "";
    var passShow = activeTab == "password" ? "show active" : "";
}

<div class="row gy-4">
    <div class="col-lg-4">
        <div class="user-grid-card position-relative border radius-16 overflow-hidden bg-base h-100">
            <img src="~/images/Banner.png" alt="" class="w-100 object-fit-cover">
            <div class="pb-24 ms-16 mb-24 me-16 mt--100">
                <div class="text-center border border-top-0 border-start-0 border-end-0">
                    @{
                        var defaultAvatar = Url.Content("~/images/default-profile.png");
                        var profileImg = string.IsNullOrEmpty(Model.ProfileImagePath)
                            ? defaultAvatar
                            : Url.Content(Model.ProfileImagePath);
                    }
                    <img src="@profileImg"
                         alt="Profile"
                         class="border br-white border-width-2-px w-200-px h-200-px rounded-circle object-fit-cover">

                    <h6 class="mb-0 mt-16">@Model.FullName</h6>
                    <span class="text-secondary-light mb-16">@Model.Email</span>
                </div>
                <div class="mt-24">
                    <h6 class="text-xl mb-16">Personal Info</h6>
                    <ul>
                        <li class="d-flex align-items-center gap-1 mb-12">
                            <span class="w-30 text-md fw-semibold text-primary-light">User Name</span>
                            <span class="w-70 text-secondary-light fw-medium">: @Model.UserName</span>
                        </li>
                        <li class="d-flex align-items-center gap-1 mb-12">
                            <span class="w-30 text-md fw-semibold text-primary-light">Full Name</span>
                            <span class="w-70 text-secondary-light fw-medium">: @Model.FullName</span>
                        </li>
                        <li class="d-flex align-items-center gap-1 mb-12">
                            <span class="w-30 text-md fw-semibold text-primary-light">Email</span>
                            <span class="w-70 text-secondary-light fw-medium">: @Model.Email</span>
                        </li>
                        <li class="d-flex align-items-center gap-1 mb-12">
                            <span class="w-30 text-md fw-semibold text-primary-light">Role</span>
                            <span class="w-70 text-secondary-light fw-medium">: @Model.Role</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body p-24">

                @* Başarılı işlem mesajları *@
                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["ProfileSuccess"]</div>
                }
                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["PasswordSuccess"]</div>
                }

                <ul class="nav border-gradient-tab nav-pills mb-20 d-inline-flex" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link d-flex align-items-center px-24 @editActive"
                                id="pills-edit-profile-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#pills-edit-profile"
                                type="button" role="tab">
                            Edit Profile
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link d-flex align-items-center px-24 @passActive"
                                id="pills-change-passwork-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#pills-change-passwork"
                                type="button" role="tab">
                            Change Password
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="pills-tabContent">
                    <!-- Edit Profile Tab -->
                    <div class="tab-pane fade @editShow" id="pills-edit-profile" role="tabpanel">
                        <h6 class="text-md text-primary-light mb-16">Profile Image</h6>

                        <form asp-action="UpdateProfile" asp-controller="User" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <!-- Upload Image -->
                            @{
                                var editImg = string.IsNullOrEmpty(Model.ProfileImagePath)
                                    ? defaultAvatar
                                    : Url.Content(Model.ProfileImagePath);
                            }

                            <div class="mb-24 mt-16">
                                <div class="avatar-upload">
                                    <div class="avatar-edit position-absolute bottom-0 end-0 me-24 mt-16 z-1 cursor-pointer">
                                        <input type="file"
                                               id="imageUpload"
                                               name="profileImageFile"
                                               accept=".png, .jpg, .jpeg"
                                               hidden>
                                        <label for="imageUpload"
                                               class="w-32-px h-32-px d-flex justify-content-center align-items-center bg-primary-50 text-primary-600 border border-primary-600 bg-hover-primary-100 text-lg rounded-circle">
                                            <iconify-icon icon="solar:camera-outline" class="icon"></iconify-icon>
                                        </label>
                                    </div>

                                    <div class="avatar-preview">
                                        <div id="imagePreview"
                                             style="background-image:url('@editImg');">
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="mb-20">
                                        <label class="form-label fw-semibold text-primary-light text-sm mb-8">
                                            User Name <span class="text-danger-600">*</span>
                                        </label>
                                        <input asp-for="UserName" class="form-control radius-8" />
                                        <span asp-validation-for="UserName" class="text-danger text-sm"></span>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="mb-20">
                                        <label class="form-label fw-semibold text-primary-light text-sm mb-8">
                                            Full Name <span class="text-danger-600">*</span>
                                        </label>
                                        <input asp-for="FullName" class="form-control radius-8" />
                                        <span asp-validation-for="FullName" class="text-danger text-sm"></span>
                                    </div>
                                </div>

                                <div class="col-sm-12">
                                    <div class="mb-20">
                                        <label class="form-label fw-semibold text-primary-light text-sm mb-8">
                                            Email <span class="text-danger-600">*</span>
                                        </label>
                                        <input asp-for="Email" class="form-control radius-8" />
                                        <span asp-validation-for="Email" class="text-danger text-sm"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center gap-3">
                                <a asp-action="Profile" class="border border-danger-600 bg-hover-danger-200 text-danger-600 text-md px-56 py-11 radius-8">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-primary border border-primary-600 text-md px-56 py-12 radius-8">
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>


                    <!-- Change Password Tab -->
                    <div class="tab-pane fade @passShow" id="pills-change-passwork" role="tabpanel">
                        <form asp-action="ChangePassword" asp-controller="User" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-20">
                                <label class="form-label fw-semibold text-primary-light text-sm mb-8">
                                    New Password <span class="text-danger-600">*</span>
                                </label>
                                <div class="position-relative">
                                    <input asp-for="NewPassword" type="password" class="form-control radius-8" id="new-password" placeholder="Enter New Password*">
                                    <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light" data-toggle="#new-password"></span>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger text-sm"></span>
                            </div>

                            <div class="mb-20">
                                <label class="form-label fw-semibold text-primary-light text-sm mb-8">
                                    Confirm Password <span class="text-danger-600">*</span>
                                </label>
                                <div class="position-relative">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control radius-8" id="confirm-password" placeholder="Confirm Password*">
                                    <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light" data-toggle="#confirm-password"></span>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger text-sm"></span>
                            </div>

                            <div class="d-flex align-items-center justify-content-center gap-3">
                                <a asp-action="Profile" class="border border-danger-600 bg-hover-danger-200 text-danger-600 text-md px-56 py-11 radius-8">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-primary border border-primary-600 text-md px-56 py-12 radius-8">
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
