@model AssignmentCore.ViewModels.UserEditViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Edit User";
    ViewData["subTitle"] = Model.Role == "Teacher" ? "Update Teacher" : "Update Student";
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h4 class="card-header text-info-500 mb-16 p-4">
        Edit @Model.Role
    </h4>

    <!-- VALIDATION -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    <form asp-action="Edit" method="post" class="row g-3">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Role" />

        <!-- USERNAME -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">User Name</label>
            <input asp-for="UserName" class="form-control radius-12" />
            <span asp-validation-for="UserName" class="text-danger text-sm d-block"></span>
        </div>

        <!-- FULLNAME -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Full Name</label>
            <input asp-for="FullName" class="form-control radius-12" />
            <span asp-validation-for="FullName" class="text-danger text-sm d-block"></span>
        </div>

        <!-- EMAIL -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Email</label>
            <input asp-for="Email" class="form-control radius-12" />
            <span asp-validation-for="Email" class="text-danger text-sm d-block"></span>
        </div>

        <!-- NEW PASSWORD -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">New Password (optional)</label>
            <input asp-for="Password" type="password" class="form-control radius-12" />
            <span asp-validation-for="Password" class="text-danger text-sm d-block"></span>
            <small class="text-slate-400">
                Leave blank to keep current password.
            </small>
        </div>

        <!-- CONFIRM PASSWORD (opsiyonel ama tavsiye edilir) -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control radius-12" />
            <span asp-validation-for="ConfirmPassword" class="text-danger text-sm d-block"></span>
        </div>

        <!-- IS ACTIVE -->
        <div class="col-md-6 d-flex align-items-start mt-3 mb-3">
            <input asp-for="IsActive" class="form-check-input me-4" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">
                Is Active
            </label>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary px-16">
                Save
            </button>

            @if (Model.Role == "Teacher")
            {
                <a asp-action="Teachers" class="btn btn-secondary px-16">
                    Back
                </a>
            }
            else
            {
                <a asp-action="Students" class="btn btn-secondary px-16">
                    Back
                </a>
            }
        </div>

    </form>
</div>