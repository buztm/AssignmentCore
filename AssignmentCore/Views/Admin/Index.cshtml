@model AssignmentCore.ViewModels.AdminDashboardViewModel
@{
    ViewData["title"] = "Dashboard";
    ViewData["subTitle"] = "Overview";
}

<div class="row g-4 mb-50 mt-50 justify-content-center">
    <!-- Total Courses -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center">
            <a href="/Course">
                <div class="stat-icon-large bg-primary-subtle text-primary mb-3">
                    <i class="bi bi-journal-bookmark"></i>
                </div>
                <div class="stat-value-large">@Model.TotalCourses</div>
                <div class="stat-label-large">Total Courses</div>
            </a>
        </div>
    </div>

    <!-- Total Assignments -->
    
    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center">
            <a href="/Assignment">
                <div class="stat-icon-large bg-success-subtle text-success mb-3">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div id="assingmentCount" class="stat-value-large">@Model.TotalAssignments</div>
                <div class="stat-label-large">Total Assignments</div>
            </a>
        </div>
    </div>
    

    <!-- Active Assignments -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center">
            <a href="/Assignment">
                <div class="stat-icon-large bg-warning-subtle text-warning mb-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div id="assignmentActiveCount" class="stat-value-large">@Model.ActiveAssignments</div>
                <div class="stat-label-large">Active Assignments</div>
            </a>
        </div>
    </div>

    @if(User.IsInRole("Admin"))
    {
        <!-- Total Users -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="dash-stat card py-5 text-center">
                <a href="@Url.Action("Students","User")">
                    <div class="stat-icon-large bg-danger-subtle text-danger mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-value-large">@Model.TotalUsers</div>
                    <div class="stat-label-large">Total Users</div>
                </a>
            </div>
        </div>
    }
</div>

<!-- SignalR -->
<div class="row g-4 mb-50 mt-50 justify-content-center">
    <div class="col-md-12">
        <div id="divResult"></div>
    </div>
</div>

<!-- Latest assignments -->
<div class="card p-16 radius-16 shadow-sm rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-16">
        <h2 class="h4 fw-semibold mb-0">Latest Assignments</h2>
    </div>

    @if (Model.LatestAssignments == null || Model.LatestAssignments.Count == 0)
    {
        <div class="alert alert-warning">
            There are no assignments yet.
        </div>
    }
    else
    {
        <div class="table-responsive radius-16">
            <table class="table striped-table align-middle">
                <thead>
                    <tr class="bg-primary">
                        <th class="text-light">Assignment</th>
                        <th class="text-light">Course</th>
                        <th class="text-light">Created At</th>
                        <th class="text-light">Due Date</th>
                        <th class="text-light">Status</th>
                    </tr>
                </thead>
                <tbody class="border-top">

                    @foreach (var a in Model.LatestAssignments)
                    {
                        <tr class="border-bottom">
                            <td class="py-2">@a.Title</td>
                            <td>@a.CourseName</td>
                            <td>@a.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>@(a.DueDate?.ToString("dd.MM.yyyy"))</td>
                            <td>
                                @if(a.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


@section Scripts {
    <script>
        var connectionHub = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub", signalR.HttpTransportType.WebSockets)
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connectionHub.on("onAssignmentAdd", (d) => {
            $("#assingmentCount").html(d);
            $("#divResult")
                .show()
                .removeClass()
                .addClass("alert alert-info")
                .html("New assignment added!")
                .fadeOut(5000);

        });
        connectionHub.on("onAssignmentUpdate", (d) => {
            $("#assignmentActiveCount").html(d);
            $("#divResult")
                .show()
                .removeClass()
                .addClass("alert alert-info")
                .html("An assignment updated!")
                .fadeOut(5000);
        });
        connectionHub.on("onAssignmentDelete", (d) => {
            $("#catCount").html(d);
            $("#divResult")
                .show()
                .removeClass()
                .addClass("alert alert-info")
                .html("An assignment deleted!")
                .fadeOut(5000);
        });


        function fullfilled() {
            console.log("SignalR Connected!");
        }
        function rejected() {
            console.log("SignalR Error!");

        }
        connectionHub.start().then(fullfilled, rejected);

    </script>
}