@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<partial name="~/Views/Shared/Partials/_Head.cshtml" />
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/student-ui.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/SignalR.js"></script>
</head>
<body>
    <partial name="~/Views/Shared/Partials/_SidebarStudent.cshtml" />

    <main class="dashboard-main">
        <partial name="~/Views/Shared/Partials/_Navbar.cshtml" />

        <div class="dashboard-main-body">
            @{
                string BreadcrumbTitle = ViewData["title"] as string ?? "";
                string BreadcrumbSubTitle = ViewData["subTitle"] as string ?? "";
            }
            <partial name="~/Views/Shared/Partials/_Breadcrumb.cshtml"
                     view-data='new ViewDataDictionary(ViewData) { { "BreadcrumbTitle", BreadcrumbTitle }, { "BreadcrumbSubTitle", BreadcrumbSubTitle } }' />
            @RenderBody()
        </div>

        <partial name="~/Views/Shared/Partials/_Footer.cshtml" />
    </main>

    <partial name="~/Views/Shared/Partials/_Scripts.cshtml" />
    @await Component.InvokeAsync("Notyf")
    @RenderSection("Scripts", required: false)
</body>
</html>

<style>
    .dash-stat {
        border: none;
        border-radius: 18px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
        transition: all 0.2s ease;
        min-height: 180px;
    }

        .dash-stat:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 35px rgba(0, 0, 0, 0.12);
        }

    .stat-icon-large {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        margin: 0 auto;
    }

    .stat-value-large {
        font-size: 40px;
        font-weight: 700;
        line-height: 1;
    }

    .stat-label-large {
        margin-top: 6px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
    }
</style>