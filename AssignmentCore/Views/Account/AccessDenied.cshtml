@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Access Denied";
    ViewData["subTitle"] = "You do not have permission";
}

<div class="card p-40 radius-16 mx-auto mt-40 shadow-sm rounded-4" style="max-width: 600px;">
    <div class="d-flex justify-content-center mb-4">
        <iconify-icon icon="solar:shield-warning-bold" class="text-danger" style="font-size: 72px;"></iconify-icon>
    </div>

    <h2 class="text-center text-white bg-danger p-10 radius-16">Access Denied</h2>

    <p class="text-center text-secondary-light mb-4">
        You do not have permission to view this page.
    </p>

    <div class="text-center">
        @if(User.IsInRole("Student"))
        {
            <a asp-controller="Student" asp-action="Overview"
               class="btn btn-primary px-32 py-12">
                Back to Overview
            </a>
        }
        else
        {
            <a asp-controller="Admin" asp-action="Index"
               class="btn btn-primary px-32 py-12">
                Back to Dashboard
            </a>
        }
    </div>
</div>
