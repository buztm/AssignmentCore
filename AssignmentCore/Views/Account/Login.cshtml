@model AssignmentCore.ViewModels.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["title"] = "Sign In";
    ViewData["subTitle"] = "Authentication";
}

<section class="auth bg-base d-flex flex-wrap">
    <div class="auth-left d-lg-block d-none">
        <div class="d-flex bg-base align-items-center flex-column h-100 justify-content-center">
            <img src="~/images/LoginBg.png" alt="">
        </div>
    </div>

    <div class="auth-right py-32 px-24 d-flex flex-column justify-content-right">
        <div class="max-w-464-px mx-auto w-100">
            <div class="mb-4 text-center">
                <a asp-controller="Home" asp-action="Index" class=" mb-40 max-w-290-px d-inline-block">
                    <img src="~/images/University-Logo.png" alt="">
                </a>
                <h4 class="mb-12">Sign In to your Account</h4>
                <p class="mb-32 text-secondary-light text-lg">Welcome back! Please enter your details.</p>
            </div>

            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- FORM -->
            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <!-- RETURN URL (hidden) -->
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- USERNAME / EMAIL -->
                <div class="position-relative mb-20">
                    <div class="icon-field">
                        <span class="icon top-50 translate-middle-y">
                            <iconify-icon icon="mage:email"></iconify-icon>
                        </span>
                        <input asp-for="UserNameOrEmail"
                               class="form-control h-56-px bg-neutral-50 radius-12"
                               placeholder="User Name or Email" />
                    </div>
                    <span asp-validation-for="UserNameOrEmail" class="text-danger text-sm d-block mt-1"></span>
                </div>

                <!-- PASSWORD -->
                <div class="position-relative mb-20">
                    <div class="icon-field">
                        <span class="icon top-50 translate-middle-y">
                            <iconify-icon icon="solar:lock-password-outline"></iconify-icon>
                        </span>
                        <input asp-for="Password"
                               type="password"
                               class="form-control h-56-px bg-neutral-50 radius-12"
                               id="your-password"
                               placeholder="Password" />
                    </div>
                    <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light"
                          data-toggle="#your-password"></span>
                    <span asp-validation-for="Password" class="text-danger text-sm d-block mt-1"></span>
                </div>

                <!-- REMEMBER ME + FORGOT -->
                <div class="d-flex justify-content-between gap-2 mb-2">
                    <div class="form-check style-check d-flex align-items-center">
                        <input asp-for="RememberMe"
                               class="form-check-input border border-neutral-300"
                               id="rememberMe" />
                        <label asp-for="RememberMe" class="form-check-label ms-1"></label>
                    </div>
                    <!--<a href="javascript:void(0)" class="text-primary-600 fw-medium">Forgot Password?</a>-->
                </div>

                <!-- SUBMIT -->
                <button type="submit"
                        class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-32">
                    Sign In
                </button>

                <div class="mt-32 text-center text-sm">
                    <p class="mb-0">
                        Don’t have an account?
                        <a href="javascript:void(0)" class="text-primary-600 fw-semibold">
                            Contact your administrator
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</section>
