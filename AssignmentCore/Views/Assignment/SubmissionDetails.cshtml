@model AssignmentCore.Models.AssignmentSubmission

@{
    var a = Model.Assignment;
    var c = a.Course;
    var student = Model.Student;
}

<div class="row g-3">
    <div class="col-lg-8">

        <div class="card p-24 radius-16 shadow-sm mb-12">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h4 class="mb-6">@a.Title</h4>
                    <div class="text-secondary-light text-sm">
                        @c.Code • @c.Name
                    </div>
                </div>

                <div class="text-end">
                    <span class="badge bg-success px-3 py-2">
                        <i class="ri-check-double-line me-1"></i>
                        Submitted
                    </span>
                    <div class="text-secondary-light text-sm mt-6">
                        @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-24 radius-16 shadow-sm mb-12">
            <h6 class="mb-10">
                <i class="ri-chat-3-line me-1"></i>
                Student Note
            </h6>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="p-16 radius-12 bg-light">
                    @Model.Note
                </div>
            }
            else
            {
                <div class="text-secondary-light">No note provided.</div>
            }
        </div>

        <div class="card p-24 radius-16 shadow-sm">
            <h6 class="mb-10">
                <i class="ri-file-list-3-line me-1"></i>
                Submitted File
            </h6>

            <div class="d-flex justify-content-between align-items-center p-16 radius-12 border">
                <div class="d-flex align-items-center gap-2">
                    <i class="ri-file-2-line fs-4"></i>
                    <div>
                        <div class="fw-semibold">@Model.OriginalName</div>
                        <div class="text-secondary-light text-sm">
                            @Model.ContentType • @Model.Size bytes
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" href="@Model.FilePath" download>
                        <i class="ri-download-2-line me-1"></i> Download
                    </a>
                    <a class="btn btn-sm btn-primary" href="@Model.FilePath" target="_blank" rel="noopener">
                        <i class="ri-external-link-line me-1"></i> Open
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <div class="card p-24 radius-16 shadow-sm">
            <h6 class="mb-12">
                <i class="ri-user-3-line me-1"></i>
                Student
            </h6>

            <div class="mb-12">
                <div class="fw-semibold">@student.FullName</div>
                <div class="text-secondary-light text-sm">@student.Email</div>
            </div>

            <hr />

            <div class="mb-10">
                <div class="text-secondary-light text-sm">Assignment Due</div>
                <div class="fw-semibold">
                    @(a.DueDate == null ? "No deadline" : a.DueDate.Value.ToString("dd MMM yyyy HH:mm"))
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary w-100"
                   asp-action="Submissions" asp-route-id="@a.Id">
                    <i class="ri-arrow-left-line me-1"></i> Back to list
                </a>
                <a class="btn btn-outline-primary w-100"
                   asp-action="Details" asp-route-id="@a.Id">
                    <i class="ri-file-info-line me-1"></i> Assignment
                </a>
            </div>
        </div>
    </div>
</div>
