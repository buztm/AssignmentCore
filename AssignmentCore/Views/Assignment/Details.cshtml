@model AssignmentCore.Models.Assignment
@{
    string FileSize(long? bytes)
    {
        if (bytes == null) return "-";
        double b = bytes.Value;
        string[] u = { "B", "KB", "MB", "GB" };
        int i = 0;
        while (b >= 1024 && i < u.Length - 1) { b /= 1024; i++; }
        return $"{b:0.#} {u[i]}";
    }
}

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card p-24 radius-16 shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-16">
                <div>
                    <h3 class="mb-6">@Model.Title</h3>
                    <div class="text-secondary-light">
                        <span class="me-3">
                            <i class="ri-book-2-line me-1"></i>
                            @Model.Course.Name
                        </span>
                        <span class="me-3">
                            <i class="ri-hashtag me-1"></i>
                            @Model.Course.Code
                        </span>
                    </div>
                </div>

                <div class="text-end">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                    <div class="mt-8 text-secondary-light text-sm">
                        <i class="ri-calendar-line me-1"></i>
                        Due: @(Model.DueDate?.ToString("dd MMM yyyy") ?? "No due date")
                    </div>
                </div>
            </div>

            <hr class="my-16" />

            <h6 class="mb-8">Description</h6>
            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="alert alert-light mb-0">No description provided.</div>
            }
            else
            {
                <p class="mb-0">@Model.Description</p>
            }
        </div>

        <div class="card p-24 radius-16 shadow-sm mt-4">
            <div class="d-flex justify-content-between align-items-center mb-12">
                <h6 class="mb-0">Attachment</h6>
            </div>

            @if (string.IsNullOrWhiteSpace(Model.AttachmentPath))
            {
                <div class="alert alert-warning mb-0">No attachment uploaded.</div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between gap-3 p-16 radius-12 bg-neutral-50">
                    <div class="d-flex align-items-center gap-3">
                        <span class="w-44-px h-44-px bg-primary-50 text-primary-600 rounded-circle d-flex justify-content-center align-items-center flex-shrink-0">
                            <i class="ri-attachment-2"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">@Model.AttachmentOriginalName</div>
                            <div class="text-sm text-secondary-light">
                                @FileSize(Model.AttachmentSize) • @Model.AttachmentContentType
                            </div>
                        </div>
                    </div>

                    <a class="btn btn-sm btn-primary"
                       href="@Model.AttachmentPath" target="_blank" rel="noopener">
                        Open
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card p-24 radius-16 shadow-sm">
            <h6 class="mb-12">Actions</h6>

            @if (User.IsInRole("Student"))
            {
                <a class="btn btn-outline-secondary w-100 mb-12"
                   asp-action="StudentIndex">
                    <i class="ri-arrow-left-line me-1"></i>
                    Back to Assignments
                </a>

                var mySub = ViewBag.MySubmission as AssignmentCore.Models.AssignmentSubmission;
                bool canSubmit = ViewBag.CanSubmit == true;

                @if (mySub != null)
                {
                    <div class="alert alert-success">
                        <div class="fw-semibold mb-1">Submitted ✅</div>
                        <div class="text-sm">Submitted at: @mySub.SubmittedAt.ToString("dd MMM yyyy HH:mm")</div>
                        <div class="mt-2">
                            <a class="btn btn-sm btn-primary"
                               asp-action="SubmissionDetails" asp-route-id="@mySub.Id">
                                <i class="ri-eye-line me-1"></i>
                                View My Submission
                            </a>
                        </div>
                    </div>
                }
                else if (!Model.IsActive)
                {
                    <div class="alert alert-warning mb-0">This assignment is not active.</div>
                }
                else if (Model.DueDate != null && Model.DueDate.Value < DateTime.UtcNow)
                {
                    <div class="alert alert-danger mb-0">Deadline passed. You can’t submit.</div>
                }
                else if (canSubmit)
                {
                    <form asp-action="Submit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AssignmentId" value="@Model.Id" />

                        <div class="mb-12">
                            <label class="form-label">Upload your file</label>
                            <input class="form-control" type="file" name="File" required />
                        </div>

                        <div class="mb-12">
                            <label class="form-label">Note (optional)</label>
                            <textarea class="form-control" name="Note" rows="3" placeholder="Add a note..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="ri-upload-cloud-2-line me-1"></i>
                            Submit Assignment
                        </button>

                        <div class="text-secondary-light text-sm mt-10">
                            You can submit only once.
                        </div>
                    </form>
                }
            }
            else
            {
                <a class="btn btn-outline-secondary w-100 mb-12"
                   asp-action="Index">
                    <i class="ri-arrow-left-line me-1"></i>
                    Back to Assignments
                </a>

                @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                {
                    <a class="btn btn-primary w-100"
                       asp-action="Submissions" asp-route-id="@Model.Id">
                        <i class="ri-eye-line me-1"></i>
                        View Submissions
                    </a>
                }
            }
        </div>
    </div>
</div>
