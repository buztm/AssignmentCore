@model List<AssignmentCore.Models.Assignment>
@{
    ViewData["title"] = "Assignments";
    ViewData["subTitle"] = "Assignment List";
}

<div class="card p-16 radius-16 shadow-sm rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-16">
        <h2 class="h4 fw-semibold mb-0">Assignment List</h2>

        @if (!User.IsInRole("Student")) 
        {
            <a asp-action="Create" class="btn btn-primary px-8">+ New Assignment</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">
            There are no assignments yet!
        </div>
    }
    else
    {
        <div class="table-responsive radius-16">
            <table class="table striped-table align-middle">
                <thead>
                    <tr class="bg-primary">
                        <th class="text-light">Title</th>
                        <th class="text-light">Course</th>
                        <th class="text-light">Due Date</th>
                        <th class="text-light">Is Active</th>
                        @if (!User.IsInRole("Student"))
                        {
                            <th class="text-light text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="border-top">
                    @foreach (var a in Model)
                    {
                        <tr class="border-bottom">

                            <td>
                                <a class="fw-semibold hover-text-info"
                                   asp-action="Details" asp-route-id="@a.Id">
                                    @a.Title
                                </a>
                            </td>


                            <td>
                                <a class="hover-text-info" href="~/Course">@a.Course.Name</a>
                            </td>

                            <td>@(a.DueDate?.ToString("dd.MM.yyyy") ?? "-")</td>

                            <td>
                                @if (User.IsInRole("Student"))
                                {
                                    <span class="badge @(a.IsActive ? "bg-success" : "bg-danger")">@(a.IsActive ? "Active" : "Inactive")</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-xs toggle-active-btn" data-id="@a.Id">
                                        <span class="badge @(a.IsActive ? "bg-success" : "bg-danger")">
                                            @(a.IsActive ? "Active" : "Inactive")
                                    </button>
                                }
                            </td>

                            @if (!User.IsInRole("Student"))
                            {
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-info me-1">
                                        Details
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-danger me-1">
                                        Delete
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".toggle-active-btn");

            buttons.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();

                    const id = this.getAttribute("data-id");

                    fetch(`/Assignment/ToggleActive?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => {
                        if (!response.ok) {
                            console.error("Request failed", response.status);
                            return null;
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (!data || !data.success) {
                            console.error("Toggle failed or no data");
                            return;
                        }

                        const badge = this.querySelector(".badge");
                        if (!badge) return;

                        if (data.isActive) {
                            badge.classList.remove("bg-danger");
                            badge.classList.add("bg-success");
                            badge.textContent = "Active";
                        } else {
                            badge.classList.remove("bg-success");
                            badge.classList.add("bg-danger");
                            badge.textContent = "Inactive";
                        }
                    })
                    .catch(err => {
                        console.error("Error in toggle call:", err);
                    });
                });
            });
        });
    </script>
}