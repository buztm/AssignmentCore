@model List<AssignmentCore.Models.Assignment>
@using AssignmentCore.Models
@using AssignmentCore.Helpers
@{
    var subMap = ViewBag.SubmissionMap as Dictionary<int, AssignmentSubmission>;
    int DaysLeft(DateTime? due)
    {
        if (due == null) return int.MaxValue;
        return (int)Math.Ceiling((due.Value.Date - DateTime.Now.Date).TotalDays);
    }

    string DueLabel(DateTime? due)
    {
        if (due == null) return "No due date";
        var d = DaysLeft(due);
        if (d < 0) return $"Overdue by {Math.Abs(d)} day(s)";
        if (d == 0) return "Due today";
        if (d == 1) return "Due tomorrow";
        return $"Due in {d} day(s)";
    }

    string DuePillClass(DateTime? due)
    {
        if (due == null) return "due-ok";
        var d = DaysLeft(due);
        if (d < 0) return "due-bad";
        if (d <= 2) return "due-warn";
        return "due-ok";
    }

    string ShortHtml(string? s, int max = 120)
    {
        if (string.IsNullOrWhiteSpace(s)) return "No description.";

        var text = s.Length > max ? s.Substring(0, max) + "..." : s;

        text = System.Net.WebUtility.HtmlEncode(text);

        text = text.Replace("\r\n", "\n").Replace("\n", "<br>");

        return text;
    }

}

@if (Model == null || Model.Count == 0)
{
    <div class="card s-card p-24 radius-16 shadow-sm">
        <div class="alert alert-light mb-0">No assignments found.</div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var a in Model)
        {
            var dueText = DueLabel(a.DueDate);
            var isSubmitted = subMap != null && subMap.ContainsKey(a.Id);
            AssignmentSubmission? sub = isSubmitted ? subMap![a.Id] : null;
            var isLate = a.DueDate != null && DaysLeft(a.DueDate) < 0;
            var pill = DuePillClass(a.DueDate);

            <div class="col-12 col-md-6 col-xl-6">
                <div class="card s-card s-assign h-100">
                    <div class="s-card-top d-flex align-items-start justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="s-icon text-primary">
                                <i class="ri-file-list-3-line"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="s-title text-truncate" title="@a.Title">@a.Title</div>
                                <div class="s-meta text-truncate" title="@a.Course?.Name">
                                    @(a.Course != null ? $"{a.Course.Code} • {a.Course.Name}" : "—")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column align-items-end gap-1">
                            <span class="s-pill @pill">@dueText</span>

                            @if (isSubmitted)
                            {
                                <span class="badge bg-success">
                                    <i class="ri-check-line me-1"></i> Submitted
                                </span>
                            }
                            else if (isLate)
                            {
                                <span class="badge bg-danger">
                                    <i class="ri-time-line me-1"></i> Deadline Passed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="ri-edit-2-line me-1"></i> Not Submitted
                                </span>
                            }
                        </div>

                    </div>

                    <div class="p-20">
                        <div class="s-meta mb-10">
                            <i class="ri-calendar-2-line me-1"></i>
                            Due: @(a.DueDate?.ToString("dd MMM yyyy") ?? "—")
                        </div>

                        <div class="s-desc mb-14 md-snippet" title="@a.Description">
                            @Html.Raw(MarkdownHelper.ToSafeHtml(ShortHtml(a.Description)))
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="text-sm">
                                @if (!string.IsNullOrWhiteSpace(a.AttachmentPath))
                                {
                                    <span class="text-success">
                                        <i class="ri-attachment-2 me-1"></i> File attached
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary-light">
                                        <i class="ri-attachment-off me-1"></i> No file
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="d-flex gap-2">
                                    @if (isSubmitted && sub != null)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary s-btn-soft"
                                           asp-action="SubmissionDetails" asp-route-id="@sub.Id">
                                            My Submission
                                        </a>
                                    }

                                    <a class="btn btn-sm btn-outline-primary s-btn-soft"
                                       asp-action="Details" asp-route-id="@a.Id">
                                        View <i class="ri-arrow-right-line ms-1"></i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
