@model AssignmentCore.Models.Assignment
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Delete Assignment";
    ViewData["subTitle"] = "Confirm Delete";
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h3 class="card-header text-danger-500 mb-16 p-4">Delete Assignment</h3>

    <div class="alert alert-danger">
        Are you sure you want to delete this assignment?
    </div>

    <div class="table-responsive radius-16">
        <table class="table striped-table align-middle">
            <thead>
                <tr class="bg-danger">
                    <th class="text-light">Title</th>
                    <th class="text-light">Due Date</th>
                    <th class="text-light">Status</th>
                </tr>
            </thead>
            <tbody class="border-top">
                <tr class="border-bottom">
                    <td>@Model.Title</td>
                    <td>@Model.DueDate?.ToString("dd.MM.yyyy")</td>
                    <td>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "Active" : "Inactive")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-danger px-16">Delete</button>
            <a asp-action="Index" class="btn btn-secondary px-16">Cancel</a>
        </div>
    </form>
</div>
