@model AssignmentCore.Models.Assignment
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Delete Course";
    ViewData["subTitle"] = "Confirm Delete";
}

<div class="card p-3 w-50">
    <p class="bg-danger text-black-50 rounded-3 p-3 mb-3">
        Are you sure you want to delete this course?
    </p>

    <table class="basic-border-table mb-3">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Due Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Title</td>
                <td>
                    @if (Model.Description != null)
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="hover-text-info">Empty!</span>
                    }
                </td>
                <td>@Model.DueDate?.ToString("dd.MM.yyyy")</td>
            </tr>
        </tbody>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="flex justify-between">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
