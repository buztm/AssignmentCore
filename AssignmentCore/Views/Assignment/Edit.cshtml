@model AssignmentCore.ViewModels.AssignmentCreateViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Edit Assignment";
    ViewData["subTitle"] = "Update Assignment";
}

<div class="card p-3 w-50">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control mb-1" />
            <span asp-validation-for="Title" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Course</label>
            <select asp-for="CourseId"
                    asp-items="Model.Courses"
                    class="form-control mb-1">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger text-sm block mt-1"></span>
        </div>

        <div class="mb-3 flex items-center gap-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Is Active</label>
            <span></span>
        </div>

        <div class="flex justify-between">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>
