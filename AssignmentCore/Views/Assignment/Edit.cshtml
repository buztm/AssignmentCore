@model AssignmentCore.ViewModels.AssignmentCreateViewModel
@{
    ViewData["title"] = "Edit Assignment";
    ViewData["subTitle"] = "Update Assignment";

    var ext = System.IO.Path.GetExtension(Model.ExistingAttachmentPath)?.ToLower();
    var icon = ext switch
    {
        ".pdf" => "ri-file-pdf-line",
        ".doc" or ".docx" => "ri-file-word-line",
        ".zip" or ".rar" => "ri-file-zip-line",
        ".jpg" or ".png" => "ri-image-line",
        ".mp4" or ".mkv" => "ri-file-video-line",
        _ => "ri-file-2-line"
    };
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h4 class="card-header text-info-500 mb-16 p-4">Edit Assignment</h4>

    <!-- VALIDATION -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
        <input type="hidden" asp-for="Id" />

        <!-- TITLE -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Title</label>
            <input asp-for="Title" class="form-control radius-12" placeholder="Enter title" />
            <span asp-validation-for="Title" class="text-danger text-sm block d-block"></span>
        </div>

        <!-- COURSE -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Course</label>
            <select asp-for="CourseId"
                    asp-items="Model.Courses"
                    class="form-control radius-12 text-center">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger text-sm block d-inline-block d-block"></span>
        </div>

        <!-- Upload File -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Files</label>
            <input asp-for="Attachment" type="file" id="attachmentInput" class="d-none" />
            <button type="button" class="btn btn-outline-primary col-md-12 radius-12" onclick="document.getElementById('attachmentInput').click()">
                <i class="ri-upload-2-line"></i>
                Upload File
            </button>

            <div id="selectedFileName" class="mt-2 text-muted small"></div>

            <span asp-validation-for="Attachment" class="text-danger text-sm d-block"></span>
        </div>

        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(Model.ExistingAttachmentPath))
            {
                <div class="mt-2">
                    <a href="@Model.ExistingAttachmentPath"
                       target="_blank"
                       class="text-decoration-none d-inline-flex align-items-center file-link hover-text-primary">
                        <i class="@icon me-2 fs-5"></i>
                        <span>@System.IO.Path.GetFileName(Model.ExistingAttachmentPath)</span>
                    </a>
                </div>
            }
        </div>

        <!-- DESCRIPTION -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">
                Description
                <span class="text-secondary-light text-sm">(Markdown supported)</span>
            </label>

            <textarea asp-for="Description"
                      class="form-control radius-12"
                      rows="6"
                      placeholder="You can use Markdown here..."></textarea>

            <div class="mt-2 text-secondary-light text-sm">
                <strong>Supported:</strong>
                <code>**bold**</code>,
                <code>*italic*</code>,
                <code>- list</code>,
                <code>`code`</code>,
                links (<code>https://example.com</code>)
            </div>
        </div>

        <div class="card mt-3 p-12 radius-12 bg-neutral-50">
            <div class="fw-semibold mb-6">
                <i class="ri-eye-line me-1"></i>
                Live Preview
            </div>

            <div id="mdPreview" class="md-content text-sm text-secondary-light">
                Start typing to see preview...
            </div>
        </div>


        <!-- DUE DATE -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control radius-12" />
            <span asp-validation-for="DueDate" class="text-danger text-sm d-block"></span>
        </div>

        <!-- IS ACTIVE -->
        <div class="col-md-6 d-flex align-items-start mt-3 mb-3">
            <input asp-for="IsActive" class="form-check-input me-4" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
            <span></span>
        </div>

        <!-- BUTTONS -->
        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary px-16">Save</button>
            <a asp-action="Index" class="btn btn-secondary px-16">Back</a>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    const fileInput = document.getElementById("attachmentInput");
    const fileNameDiv = document.getElementById("selectedFileName");

    if (fileInput) {
        fileInput.addEventListener("change", function () {
            if (this.files.length > 0) {
                fileNameDiv.innerHTML =
                    `<div class="mt-2">
                        <i class="ri-file-text-line me-2 fs-5 text-primary"></i>
                        <i class=" text-primary me-2 fs-5">${this.files[0].name}</i>
                    </div>`;
            }
        });
    }

      marked.setOptions({
      breaks: true
    });

    const descInput = document.querySelector('textarea[name="Description"]');
    const preview = document.getElementById('mdPreview');

    if (descInput && preview) {
      const render = () => {
        const text = descInput.value || "";
        preview.innerHTML = marked.parse(text);
      };

      descInput.addEventListener('input', render);
      render();
    }
</script>