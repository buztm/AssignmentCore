@model AssignmentCore.ViewModels.CourseAssignStudentsViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Assign Students";
    ViewData["subTitle"] = Model.CourseName;
}

<div class="card p-4 row g-4 mb-50 mt-50">
    <h2 class="text-xl font-semibold mb-3">Assign Students to @Model.CourseName</h2>

    <form asp-action="AssignStudents" method="post">
        <input type="hidden" asp-for="CourseId" />

        <div class="mb-3">
            @foreach (var s in Model.Students)
            {
                var isChecked = Model.SelectedStudentIds.Contains(int.Parse(s.Value));
                <div class="form-check p-1">
                    <input class="form-check-input" 
                        type="checkbox" 
                        name="SelectedStudentIds" 
                        value="@s.Value" @(isChecked ? "checked" : "") />
                    <label class="form-check-label">- @s.Text</label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
