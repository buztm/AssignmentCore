@model AssignmentCore.ViewModels.CourseAssignStudentsViewModel
@{
    ViewData["title"] = "Assign Students";
    ViewData["subTitle"] = Model.CourseName;
}

<div class="card p-40 radius-16 w-50 mx-10 mt-auto shadow-sm rounded-4">
    <h4 class="card-header text-info-500 mb-16 p-4">Assign Students to <br /> @Model.CourseName</h4>

    <form asp-action="AssignStudents" method="post">
        <input type="hidden" asp-for="CourseId" />

        <div class="row g-2 align-items-end mb-16">
            <div class="col-12 col-md-6">
                <label class="form-label fw-semibold">Search students</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ri-search-line"></i></span>
                    <input id="studentSearch" class="form-control" placeholder="Type name/email..." />
                </div>
            </div>

            <div class="col-12 col-md-6 d-flex gap-2 justify-content-md-end">
                <button type="button" id="btnSelectAll" class="btn btn-outline-primary">
                    <i class="ri-check-double-line me-1"></i> Select all (visible)
                </button>
                <button type="button" id="btnClearAll" class="btn btn-outline-secondary">
                    <i class="ri-close-circle-line me-1"></i> Clear
                </button>
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-primary">
                        Selected: <span id="selectedCount">0</span>
                    </span>

                    <div class="col-md-6 d-flex align-items-start mt-3 mb-3">
                        <input class="form-check-input me-4" type="checkbox" id="toggleSelectedOnly">
                        <label class="form-check-label fw-semibold" for="toggleSelectedOnly">
                            Show selected only
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div id="studentsList" class="col-md-12 students-list">
            @foreach (var s in Model.Students)
            {
                var isChecked = Model.SelectedStudentIds.Contains(int.Parse(s.Value));
                <div class="student-item d-flex align-items-start mt-3 mb-3"
                     data-text="@s.Text.ToLowerInvariant()">

                    <input class="form-check-input me-4 student-check"
                           type="checkbox"
                           name="SelectedStudentIds"
                           value="@s.Value" @(isChecked ? "checked" : "") />

                    <label class="form-check-label fw-semibold">
                        - @s.Text
                    </label>
                </div>  
            }
        </div>

        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary px-16">Save</button>
            <a asp-action="Index" class="btn btn-secondary px-16">Back</a>
        </div>
    </form>
</div>


<style>
    .students-list {
        max-height: 420px;
        overflow: auto;
        padding-right: 6px;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 12px;
        padding: 12px 16px;
        background: rgba(0,0,0,.02);
    }

    .student-item {
        padding: 8px 10px;
        border-radius: 10px;
    }

        .student-item:hover {
            background: rgba(0,0,0,.04);
        }

        .student-item.hidden {
            display: none;
        }
</style>

<script>
    const searchInput = document.getElementById('studentSearch');
    const list = document.getElementById('studentsList');
    const items = Array.from(document.querySelectorAll('.student-item'));
    const checks = Array.from(document.querySelectorAll('.student-check'));
    const selectedCount = document.getElementById('selectedCount');
    const btnSelectAll = document.getElementById('btnSelectAll');
    const btnClearAll = document.getElementById('btnClearAll');
    const toggleSelectedOnly = document.getElementById('toggleSelectedOnly');

    function updateCount(){
        selectedCount.textContent = checks.filter(c => c.checked).length;
    }

    function applyFilter(){
        const q = (searchInput.value || '').trim().toLowerCase();
        const selectedOnly = toggleSelectedOnly.checked;

        items.forEach(item => {
            const text = item.getAttribute('data-text') || '';
            const checkbox = item.querySelector('.student-check');
            const match = q === '' || text.includes(q);
            const passSelected = !selectedOnly || (checkbox && checkbox.checked);

            item.classList.toggle('hidden', !(match && passSelected));
        });
    }

    // typing filter
    searchInput?.addEventListener('input', () => {
        applyFilter();
    });

    // selected-only toggle
    toggleSelectedOnly?.addEventListener('change', () => {
        applyFilter();
    });

    // update count when checking
    checks.forEach(c => {
        c.addEventListener('change', () => {
            updateCount();
            applyFilter();
        });
    });

    // select all visible
    btnSelectAll?.addEventListener('click', () => {
        items.forEach(item => {
            if (!item.classList.contains('hidden')) {
                const cb = item.querySelector('.student-check');
                if (cb) cb.checked = true;
            }
        });
        updateCount();
        applyFilter();
    });

    // clear all
    btnClearAll?.addEventListener('click', () => {
        checks.forEach(cb => cb.checked = false);
        updateCount();
        applyFilter();
    });

    // init
    updateCount();
    applyFilter();
</script>
