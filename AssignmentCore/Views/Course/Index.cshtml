@model List<AssignmentCore.Models.Course>
@{
    ViewData["title"] = "Courses";
    ViewData["subTitle"] = "Course List";
}

<div class="card p-16 radius-16 shadow-sm rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-16">
        <h2 class="h4 fw-semibold mb-0">Course List</h2>

        @if (!User.IsInRole("Student")) 
        {
            <a asp-action="Create" class="btn btn-primary px-8">+ New Course</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">
            There are no courses yet!
        </div>
    }
    else
    {
        <div class="table-responsive radius-16">
            <table class="table striped-table align-middle">
                <thead>
                    <tr class="bg-primary">
                        <th class="text-light">Course Code</th>
                        <th class="text-light">Name</th>
                        <th class="text-light">Description</th>
                        <th class="text-light">Is Active</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-right text-light">Teacher</th>
                        }

                        @if (!User.IsInRole("Student"))
                        {
                            <th class="text-end text-light">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="border-top">
                    @foreach (var c in Model)
                    {
                        <tr class="border-bottom">
                            <td>@c.Code</td>
                            <td>@c.Name</td>

                            <td>
                                @if (c.Description != null)
                                {
                                    @c.Description
                                }
                                else
                                {
                                    <span>Empty!</span>
                                }
                            </td>

                            <td>
                                @if (User.IsInRole("Student"))
                                {
                                    <span class="badge @(c.IsActive ? "bg-success" : "bg-danger")">@(c.IsActive ? "Active" : "Inactive")</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-xs toggle-active-btn" data-id="@c.Id">
                                        <span class="badge @(c.IsActive ? "bg-success" : "bg-danger")">
                                            @(c.IsActive ? "Active" : "Inactive")
                                    </button>
                                }
                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    <a class="hover-text-info" href="@Url.Action("Teachers", "User")">@c.Teacher.FullName</a>
                                </td>
                            }

                            @if (!User.IsInRole("Student"))
                            {
                                <td class="text-end">
                                    <a asp-action="AssignStudents" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info me-1">
                                        Students
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger me-1">
                                        Delete
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".toggle-active-btn");

            buttons.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();

                    const id = this.getAttribute("data-id");

                    fetch(`/Course/ToggleActive?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => {
                        if (!response.ok) {
                            console.error("Request failed", response.status);
                            return null;
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (!data || !data.success) {
                            console.error("Toggle failed or no data");
                            return;
                        }

                        const badge = this.querySelector(".badge");
                        if (!badge) return;

                        if (data.isActive) {
                            badge.classList.remove("bg-danger");
                            badge.classList.add("bg-success");
                            badge.textContent = "Active";
                        } else {
                            badge.classList.remove("bg-success");
                            badge.classList.add("bg-danger");
                            badge.textContent = "Inactive";
                        }
                    })
                    .catch(err => {
                        console.error("Error in toggle call:", err);
                    });
                });
            });
        });
    </script>
}