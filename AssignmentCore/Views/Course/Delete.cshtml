@model AssignmentCore.Models.Course
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["title"] = "Delete Course";
    ViewData["subTitle"] = "Confirm Delete";
}

<div class="card p-16 radius-16 w-50 mx-10 shadow-sm rounded-4">

    <h4 class="card-header text-danger-500 mb-16 p-4">Delete Course</h4>

    <div class="alert alert-danger">
        Are you sure you want to delete this course?
    </div>

    <div class="table-responsive radius-16">
        <table class="table striped-table align-middle">
            <thead>
                <tr class="bg-danger">
                    <th class="text-light">Course Code</th>
                    <th class="text-light">Name</th>
                    <th class="text-light">Status</th>
                </tr>
            </thead>
            <tbody class="border-top">
                <tr class="border-bottom">
                    <td>@Model.Code</td>
                    <td>@Model.Name</td>
                    <td>
                        @if(Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-dange">Inactive</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="flex justify-between">
            @if (ViewBag.HasAssignments || ViewBag.HasStudents)
            {
                <div class="alert alert-warning">
                    There are
                    @if (ViewBag.HasAssignments)
                    {
                        <text>assignments</text>
                    }
                    @if (ViewBag.HasAssignments && ViewBag.HasStudents)
                    {
                        <text> and </text>
                    }
                    @if (ViewBag.HasStudents)
                    {
                        <text>students</text>
                    }
                    under this course!
                </div>

                <div class="col-12 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary px-16">Cancel</a>
                </div>
            }
            else
            {
                <div class="col-12 d-flex justify-content-between">
                    <button type="submit" class="btn btn-danger px-16">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary px-16">Cancel</a>
                </div>
            }
        </div>
    </form>
</div>
