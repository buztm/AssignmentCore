@model AssignmentCore.Models.Course
@{
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
}

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card p-24 radius-16 shadow-sm">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h4 class="mb-6">@Model.Code • @Model.Name</h4>
                    <div class="text-secondary-light">
                        <i class="ri-user-3-line me-1"></i>
                        Teacher: @(Model.Teacher?.FullName ?? "—")
                    </div>
                </div>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>

            <hr class="my-16" />

            <h6 class="mb-8">Description</h6>
            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="alert alert-light mb-0">No description provided.</div>
            }
            else
            {
                <p class="mb-0">@Model.Description</p>
            }
        </div>

        <div class="card p-24 radius-16 shadow-sm mt-4">
            <div class="d-flex justify-content-between align-items-center mb-12">
                <h6 class="mb-0">Assignments</h6>
                <span class="badge bg-primary">Total: @Model.Assignments.Count</span>
            </div>

            @if (!Model.Assignments.Any())
            {
                <div class="alert alert-warning mb-0">No assignments yet.</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var a in Model.Assignments.OrderBy(x => x.DueDate ?? DateTime.MaxValue))
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           asp-controller="Assignment" asp-action="Details" asp-route-id="@a.Id">
                            <div>
                                <div class="fw-semibold">@a.Title</div>
                                <div class="text-sm text-secondary-light">
                                    Due: @(a.DueDate?.ToString("dd MMM yyyy") ?? "—")
                                </div>
                            </div>
                            <span class="badge @(a.IsActive ? "bg-success" : "bg-danger")">
                                @(a.IsActive ? "Active" : "Inactive")
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card p-24 radius-16 shadow-sm">
            <h6 class="mb-12">Quick Actions</h6>

            <a class="btn btn-outline-secondary w-100"
               asp-action="StudentIndex">
                <i class="ri-arrow-left-line me-1"></i>
                Back to My Courses
            </a>
        </div>
    </div>
</div>
