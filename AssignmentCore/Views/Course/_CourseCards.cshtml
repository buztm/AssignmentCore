@model List<AssignmentCore.Models.Course>
@{
    string Short(string? s, int max = 120)
    {
        if (string.IsNullOrWhiteSpace(s)) return "No description.";
        return s.Length > max ? s.Substring(0, max) + "..." : s;
    }
}

@if (Model == null || Model.Count == 0)
{
    <div class="card s-card p-24 radius-16 shadow-sm">
        <div class="alert alert-light mb-0">No courses found.</div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model.OrderByDescending(x => x.IsActive).ThenBy(x => x.Code))
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card s-card s-course h-100">
                    <div class="s-card-top d-flex align-items-start justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="s-icon text-primary">
                                <i class="bi bi-journal-bookmark"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="s-title text-truncate" title="@c.Code">@c.Code</div>
                                <div class="s-meta text-truncate" title="@c.Name">@c.Name</div>
                            </div>
                        </div>

                        <span class="s-pill @(c.IsActive ? "due-ok" : "due-bad")">
                            @(c.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="p-20">
                        <div class="s-desc mb-14" title="@c.Description">
                            @Short(c.Description)
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <span class="text-sm text-secondary-light">
                                <i class="ri-user-3-line me-1"></i>
                                Teacher: @(c.Teacher?.FullName ?? "—")
                            </span>

                            <a class="btn btn-sm btn-outline-primary s-btn-soft"
                               asp-action="DetailsStudent" asp-route-id="@c.Id">
                                Open <i class="ri-arrow-right-line ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
