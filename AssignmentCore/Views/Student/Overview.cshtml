@model AssignmentCore.ViewModels.StudentOverviewViewModel
@{
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
    ViewData["title"] = "Overview";
    ViewData["subTitle"] = "Your quick snapshot";
}

<div class="stu-page stu-overview row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center s-stat">
            <a href="@Url.Action("My", "Course")">
                <div class="stat-icon-large bg-primary-subtle text-primary mb-3">
                    <i class="bi bi-journal-bookmark"></i>
                </div>
                <div class="stat-value-large">@Model.TotalCourses</div>
                <div class="stat-label-large">My Courses</div>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center s-stat">
            <a href="@Url.Action("My", "Assignment")">
                <div class="stat-icon-large bg-success-subtle text-success mb-3">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div id="assignmentCount" class="stat-value-large">@Model.TotalAssignments</div>
                <div class="stat-label-large">My Assignments</div>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center s-stat">
            <a href="@Url.Action("My", "Assignment")">
                <div class="stat-icon-large bg-warning-subtle text-warning mb-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div id="dueSoonCount" class="stat-value-large">@Model.DueSoonCount</div>
                <div class="stat-label-large">Due Soon (7 days)</div>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="dash-stat card py-5 text-center s-stat">
            <a href="@Url.Action("My", "Assignment")">
                <div class="stat-icon-large bg-danger-subtle text-danger mb-3">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div id="overdueCount" class="stat-value-large">@Model.OverdueCount</div>
                <div class="stat-label-large">Overdue</div>
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div id="studentSignal" style="display:none;"></div>
    </div>
</div>

<div class="stu-page stu-overview card s-card rounded-4">
    <div class="s-card-top d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h4 fw-semibold mb-0">Upcoming Assignments</h2>
            <div class="text-secondary-light mt-1">Your nearest deadlines at a glance.</div>
        </div>
        <a class="btn btn-sm btn-outline-primary s-btn-soft" href="@Url.Action("My","Assignment")">
            View all
        </a>
    </div>

    <div class="p-20">
        @if (Model.UpcomingAssignments == null || Model.UpcomingAssignments.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No upcoming assignments.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var a in Model.UpcomingAssignments)
                {
                    var dueText = a.DueDate?.ToString("dd MMM yyyy") ?? "—";
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card s-card h-100">
                            <div class="s-card-top d-flex align-items-start justify-content-between gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="s-icon text-primary">
                                        <i class="ri-file-list-3-line"></i>
                                    </span>
                                    <div class="min-w-0">
                                        <div class="s-title text-truncate" title="@a.Title">@a.Title</div>
                                        <div class="s-meta text-truncate" title="@a.CourseName">@a.CourseName</div>
                                    </div>
                                </div>

                                <span class="s-pill @(a.IsActive ? "due-ok" : "due-bad")">
                                    @(a.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>

                            <div class="p-20">
                                <div class="s-meta mb-14">
                                    <i class="ri-calendar-2-line me-1"></i>
                                    Due: @dueText
                                </div>

                                <a class="btn btn-sm btn-outline-primary s-btn-soft w-100"
                                   href="@Url.Action("Details","Assignment", new { id = a.Id })">
                                    Open assignment <i class="ri-arrow-right-line ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var connectionHub = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub", signalR.HttpTransportType.WebSockets)
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connectionHub.on("onAssignmentAdd", (d) => {
            $("#assignmentCount").html(d);
            $("#studentSignal")
                .show()
                .removeClass()
                .addClass("alert alert-info")
                .html("New assignment added! Refresh to see details.")
                .fadeOut(5000);
        });

        connectionHub.on("onAssignmentUpdate", (d) => {
            $("#studentSignal")
                .show()
                .removeClass()
                .addClass("alert alert-info")
                .html("An assignment was updated! Refresh to see changes.")
                .fadeOut(5000);
        });

        function fullfilled() { console.log("SignalR Connected!"); }
        function rejected() { console.log("SignalR Error!"); }
        connectionHub.start().then(fullfilled, rejected);
    </script>
}
